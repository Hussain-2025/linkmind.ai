PORT=5000
CLIENT_URL="http://localhost:5173"
APP_URL="http://localhost:5000"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your_api_key"

# MongoDB Connection String (fallback will automatically use a local mongodb memory server if empty)
MONGODB_URI="mongodb+srv://username:password@cluster0.mongodb.net/linkmind?retryWrites=true&w=majority"

# JWT Secret for signing access tokens and session handling
JWT_SECRET="super-secret-linkmind-jwt-key-2026"

# Redis Connection URL (e.g., Redis Cloud, Railway Redis, Upstash)
# Activates BullMQ background ingestion, clustered Socket.IO adapters, and fast caching
REDIS_URI="redis://default:password@host:port"
