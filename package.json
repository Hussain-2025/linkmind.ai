{
  "name": "linkmind-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AI-powered URL shortener & realtime analytics platform built on the MERN stack with TypeScript, Socket.IO, Redis, and Gemini AI.",
  "author": "Naresh Kamarthy",
  "license": "MIT",
  "homepage": "https://github.com/yourusername/linkmind-ai#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/linkmind-ai.git"
  },
  "keywords": [
    "url-shortener",
    "link-analytics",
    "mern-stack",
    "typescript",
    "react",
    "node",
    "mongodb",
    "socket-io",
    "redis",
    "gemini-ai",
    "realtime-analytics",
    "saas"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "seed:admin": "tsx server/scripts/seedAdmin.ts",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.77.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "geoip-lite": "^1.4.10",
    "helmet": "^8.2.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "mongoose": "^9.6.2",
    "motion": "^12.23.24",
    "node-cron": "^4.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "mongodb-memory-server": "^11.1.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
